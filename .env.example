# ─────────────────────────────────────────────────────────────────────────────
# CineAmman — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic / Claude API
# Get this from: https://console.anthropic.com → API Keys → Create key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Supabase — Public keys (safe to expose to browser)
# Get these from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase — Service role key (SECRET — server-side only, never expose to browser)
# Same location: Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Site URL
# Use http://localhost:3000 during development
# Change to your real domain when deploying (e.g. https://cineamman.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard password (choose anything you like)
ADMIN_PASSWORD=choose-a-strong-password-here

# TMDB API key (for movie posters)
# Get this from: https://www.themoviedb.org → Settings → API
TMDB_API_KEY=your-tmdb-api-key-here
